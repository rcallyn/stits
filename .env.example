# Copy to .env.local and fill in. See README.md for details.

# Postgres. Use the Supabase transaction pooler (*.pooler.supabase.com:6543),
# not the direct 5432 connection.
DATABASE_URL=

# Random string used to sign the session / pending-2FA cookies.
SESSION_SECRET=

# Login password. Set APP_PASSWORD_HASH (preferred) or APP_PASSWORD.
# Generate a hash with: node scripts/hash-password.mjs 'your password'
APP_PASSWORD_HASH=
APP_PASSWORD=

# Quick-add natural-language parsing.
ANTHROPIC_API_KEY=

# Login second factor (push notification). Also used to send the 7am
# daily digest.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Authorizes Vercel Cron to hit /api/cron/daily-digest. Vercel automatically
# sends this as `Authorization: Bearer <value>` on cron-triggered requests
# once it's set as an env var — generate any random string.
CRON_SECRET=
