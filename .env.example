# Copy to .env.local and fill in. See README.md for details.

# Postgres. Use the Supabase transaction pooler (*.pooler.supabase.com:6543),
# not the direct 5432 connection.
DATABASE_URL=

# Random string used to sign the session / pending-2FA cookies.
SESSION_SECRET=

# Only read by scripts/migrate-multi-user.mjs, to create the first admin
# account. Generate a hash with: node scripts/hash-password.mjs 'your password'
# (APP_PASSWORD, plaintext, also works). Not needed by the running app.
OWNER_EMAIL=
APP_PASSWORD_HASH=

# Quick-add natural-language parsing.
ANTHROPIC_API_KEY=

# Pushover app token: sends login codes, the 7am digest and signup alerts
# to users who've saved their own Pushover user key in the app.
PUSHOVER_APP_TOKEN=
# Only read by the migration script: the first admin's Pushover user key.
PUSHOVER_USER_KEY=

# Authorizes Vercel Cron to hit /api/cron/daily-digest. Vercel automatically
# sends this as `Authorization: Bearer <value>` on cron-triggered requests
# once it's set as an env var — generate any random string.
CRON_SECRET=
